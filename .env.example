# Set these in Render's Environment settings. Do not commit real credentials.
# Local npm start uses SQLite without these variables.
NODE_ENV=production
TRUST_PROXY=1
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# A JSON array of account objects, containing scrypt password hashes.
# See readme.md for each account's required fields and password generation.
AUTH_USERS_JSON=[]
